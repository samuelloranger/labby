{
  "name": "labby",
  "version": "1.9.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted homelab dashboard: one Bun process serving a JSON API, a Svelte SPA, and an SSE stream.",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "build": "bun run scripts/vendor-icons.ts && bun run build:web && bun run build:server",
    "build:web": "cd src/web && bun run build",
    "build:server": "bun build src/server/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "vendor-icons": "bun run scripts/vendor-icons.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "playwright": "1.63.0",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4"
  }
}
